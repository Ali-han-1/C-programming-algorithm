int sadece_harf_mi(char dizi[]) {
    for (int j = 0; dizi[j] != '\0'; j++) {
        if (!isalpha(dizi[j])) {
            return 0; // Harf dışında bir karakter (rakam, sembol vb.) bulundu
        }
    }
    return 1; // Hepsi harf
}
