void ogr_veri_kaydet(struct yazdirma shd[], int i) {
    
    FILE *dosya = fopen("notlar.txt", "a");

    if (dosya == NULL) {
        printf("\n Hata: Dosya acilamadi!\n");
        return; 
    }
    fprintf(dosya, "ID: %d Ad: %s Soyad: %s Vize: %.2f Final: %.2f Ortalama: %.2f\n", 
            shd[i].ogrenciNo, shd[i].ad, shd[i].soyad, shd[i].vize, shd[i].final, shd[i].ortalama);

    fclose(dosya); 

    printf("\n -> Ogrenci bilgileri notlar.txt dosyasina basariyla kaydedildi!\n");
}

