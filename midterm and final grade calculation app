void text_olarak_isleme(struct yazdirma shd[], int i){
FILE *fp = fopen("notlar.txt","w"); 
if (fp == NULL) return;

for (int j = 0; j < i; j++){
    fprintf(fp, "ID: %d Ad: %s Soyad: %s Vize: %.2f Final: %.2f Ortalama: %.2f\n", shd[j].ogrenciNo, shd[j].ad, shd[j].soyad, shd[j].vize, shd[j].final, shd[j].ortalama);
}
fclose(fp);
printf("\n -> Tum veriler notlar.txt dosyasina kalici olarak islendi!\n");
}

int verileri_yukle(struct yazdirma shd[])
{
    FILE *dosya = fopen("notlar.txt", "r");
    if (dosya == NULL) return 0; 

    int count = 0;
    
    while (fscanf(dosya, "ID: %d Ad: %s Soyad: %s Vize: %f Final: %f Ortalama: %f\n", 
           &shd[count].ogrenciNo, shd[count].ad, shd[count].soyad, 
           &shd[count].vize, &shd[count].final, &shd[count].ortalama) != EOF) {
        count++;
        if (count >= size) break; 
    }
    fclose(dosya);
    return count; 
}
