void student_Ekle (struct yazdirma shd[], int i)
{
    // 1) Öğrenci No Giriş Kontrolü
    while(1)
    {
        printf("\nogrenci no giriniz : ");
        // Sayı dışında bir şey girilirse scanf 0 döner
        if (scanf("%d", &shd[i].ogrenciNo) == 1) 
        {
            break; // Geçerli sayı girildi, döngüden çık
        } 
        else 
        {
            printf("Hata! Lutfen sadece rakamlardan olusan bir numara girin.\n");
            while (getchar() != '\n'); // Hatalı karakterleri temizle (sonsuz döngüyü önler)
        }
    }
    
    // 2) Ad ve Soyad Harf Kontrolü
    while (1)
    {
        printf("\nogrenci adi giriniz : ");
        scanf("%19s", shd[i].ad);
        
        printf("\nsoyad giriniz : ");
        scanf("%19s", shd[i].soyad);
        
        // Her iki girdi de sadece harflerden mi oluşuyor?
        if (sadece_harf_mi(shd[i].ad) && sadece_harf_mi(shd[i].soyad))
        {
            break; // İkisi de sadece harf ise döngüyü bitir
        }
        else
        {
            printf("Hata! Ad ve soyad sadece harflerden olusmalidir. Tekrar deneyin.\n");
        }
    }
}

