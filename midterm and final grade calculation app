void student_veri_isleme_okuma(struct yazdirma shd[],int i){

    int girilen_NO = 0;
    int okunan_id;
    char okunan_ad[20];
    char okunan_soyad[20];
    float okunan_vize, okunan_final, okunan_ortalama;
    int tarama_sonuc = 0;

    printf(" \n Hangi numarali ogrencinin notunu okumak istiyorsun : ");
    scanf("%d", &girilen_NO);
    
    FILE *dosya = fopen("notlar.txt", "r");
    
    if (dosya == NULL) {
        printf("\n Hata: Henuz kaydedilmis bir ogrenci (notlar.txt) yok!\n");
        return; 
    }

    while (fscanf(dosya, "ID: %d Ad: %19s Soyad: %19s Vize: %f Final: %f Ortalama: %f\n", 
            &okunan_id, okunan_ad, okunan_soyad, &okunan_vize, &okunan_final, &okunan_ortalama) != EOF) 
    {
        
        if (girilen_NO == okunan_id)
        {
            printf("\n --- Ogrencinin Bilgileri ---\n");
            printf(" ID: %d\n Ad: %s\n Soyad: %s\n Ortalama: %.2f\n", okunan_id, okunan_ad, okunan_soyad, okunan_ortalama);
            
            tarama_sonuc = 1; 
            harf_notu_hesaplama(okunan_ortalama);
            break; 
        } 
    }
    
    
    if (tarama_sonuc == 0) {
         printf("\n !! Bu numaraya ait ogrenci bulunamadi !!\n");
    }

    fclose(dosya);
}                              

