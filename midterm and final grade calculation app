void student_veri_isleme_guncelleme(struct yazdirma shd[], int i) {
    int girilen_NO = 0;
    int islem_secimi;
    int tarama_sonuc_2 = 0;
    int ogrenci_index = -1;

    printf("\n Guncellemek istediginiz ogrencinin numarasini (ID) giriniz : ");
    scanf("%d", &girilen_NO);

    for (int j = 0; j < i; j++) {
        if (girilen_NO == shd[j].ogrenciNo) {
           tarama_sonuc_2 = 1;
            
            ogrenci_index = j;
            break;
        }
    }

    if (tarama_sonuc_2 == 0) {
        printf("\n !! Bu numaraya ait ogrenci dizide bulunamadi !!\n");
        return; 
    }

    islem_secimi = islemler();

    if (islem_secimi == 1) {
        printf(" \n Yeni Vize Notunu Giriniz: ");
        scanf("%f", &shd[ogrenci_index].vize);
    } 
    else if (islem_secimi == 2) {
        printf(" \n Yeni Final Notunu Giriniz: ");
        scanf("%f", &shd[ogrenci_index].final);
    } 
    else if (islem_secimi == 3) {
         return;
    }
    else {
        printf(" \n Gecersiz secim.\n");
        return;
    }

    shd[ogrenci_index].ortalama = (shd[ogrenci_index].vize * 0.40) + (shd[ogrenci_index].final * 0.60);
    printf("\n Yeni Ortalama: %.2f\n", shd[ogrenci_index].ortalama);

    harf_notu_hesaplama(shd[ogrenci_index].ortalama); 
    
    text_olarak_isleme(shd, i);
   
}

