void student_ortalama_hesaplama(struct yazdirma shd[],int i){

    printf(" \nvize notu giriniz ");
    scanf("%f",&shd[i].vize);
    printf(" \nfinal notunu giriniz ");
    scanf("%f",&shd[i].final);
    shd[i].ortalama = (shd[i].vize*0.40 + shd[i].final*0.60);
    printf("\n orttalama = %f",shd[i].ortalama);

}

//

void harf_notu_hesaplama(float gelen_ortalama){

     int kucultme = (int)(gelen_ortalama / 10);
    
    if ( kucultme == 10 || kucultme == 9 )
    {
        printf(" \n Harf Notu : AA \n ");
    }
    else if ( kucultme == 8 )
    {
        printf(" \n Harf Notu : BA \n ");
    }
    else if ( kucultme == 7 )
    {
        printf(" \n Harf Notu : BB \n ");
    }
    else if ( kucultme == 6 )
    {
        printf(" \n Harf Notu : CB \n ");
    }
    else if ( kucultme == 5 )
    {
        printf(" \n Harf Notu : CC \n ");
    }
    else
    {
        printf(" \n Harf Notu : FF \n ");
    }

}

